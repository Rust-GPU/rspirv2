%49 = OpFOrdGreaterThan  %23  %44 %46
%50 = OpSelect  %10  %48 %19 %47
%51 = OpSelect  %10  %49 %26 %50
OpLine %5 59 13
%52 = OpAtomicIAdd  %10  %33 %27 %28 %51
