
#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint a = 64;
layout(constant_id = 1) const uint b = 64;
layout(constant_id = 2) const int c = 64;

layout(set = 0, binding = 0) buffer Data {
    uint data[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    data[idx] = a * b + int(c);
}
